<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html>
<html>
<head>
    <title>Add New Room - Staff Portal</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; }
        .form-group { margin-bottom: 15px; }
        label { display: inline-block; width: 140px; font-weight: bold; }
        input, select { padding: 8px; width: 300px; }
        .btn { padding: 10px 15px; background: #28a745; color: white; border: none; cursor: pointer; }
    </style>
</head>
<body>
    <h2>Add New Room</h2>
    <form action="add-room" method="post">
        <div class="form-group">
            <label>Room ID:</label>
            <input type="text" name="roomId" required placeholder="e.g., R301">
        </div>
        <div class="form-group">
            <label>Room Name:</label>
            <input type="text" name="roomName" required placeholder="e.g., Estate Suite">
        </div>
        <div class="form-group">
            <label>Room Type:</label>
            <select name="roomType" required>
                <option value="StandardRoom">Standard Room</option>
                <option value="DeluxeRoom">Deluxe Room</option>
                <option value="SuiteRoom">Suite Room</option>
            </select>
        </div>
        <div class="form-group">
            <label>Room Number:</label>
            <input type="number" name="roomNumber" required placeholder="e.g., 301">
        </div>
        <div class="form-group">
            <label>Base Rate (LKR):</label>
            <input type="number" step="0.01" name="baseRate" required placeholder="e.g., 46000.00">
        </div>
        <div class="form-group">
            <label>Capacity:</label>
            <input type="number" name="capacity" required placeholder="e.g., 4">
        </div>
        <div class="form-group">
            <label>Room Size (m²):</label>
            <input type="number" name="roomSize" required placeholder="e.g., 62">
        </div>
        <div class="form-group">
            <label>Image URL:</label>
            <input type="text" name="imageUrl" required placeholder="https://images.unsplash.com/...">
        </div>
        <div class="form-group">
            <label>Status:</label>
            <select name="status">
                <option value="active">Active</option>
                <option value="maintenance">Maintenance</option>
            </select>
        </div>
        <button type="submit" class="btn">Add Room</button>
        <a href="room-list">Back to List</a>
    </form>
</body>
</html>