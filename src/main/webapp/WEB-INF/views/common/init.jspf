<%--
  Include FIRST in every page:  <%@ include file="/WEB-INF/views/common/init.jspf" %>
  Declares the tag libraries and sets ${ctx} (the app's context path) for building URLs.
--%><%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@
  taglib prefix="c" uri="jakarta.tags.core" %><%@
  taglib prefix="fn" uri="jakarta.tags.functions" %><%@
  taglib prefix="fmt" uri="jakarta.tags.fmt" %><c:set var="ctx" value="${pageContext.request.contextPath}"/><c:set var="me" value="${sessionScope.currentUser}"/>
